{
  "name": "intro-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "indexnow": "node scripts/indexnow.mjs",
    "embeddings:build": "node --env-file=.env.local scripts/build-embeddings.mjs",
    "profile:sync": "node --env-file=.env.local scripts/export-profile.mjs",
    "persona:eval": "tsx --env-file=.env.local scripts/persona-eval.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "firebase": "^11.7.1",
    "firebase-admin": "^13.7.0",
    "i18next": "^25.2.1",
    "next": "^16.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
