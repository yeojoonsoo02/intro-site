rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Server-only collections (Admin SDK bypasses rules)
    match /chat_logs/{doc} {
      allow read, write: if false;
    }
    match /knowledge_custom/{doc} {
      allow read, write: if false;
    }
    match /knowledge_pending/{doc} {
      allow read, write: if false;
    }
    match /rate_limits/{doc} {
      allow read, write: if false;
    }

    // Profiles: public read, admin write
    match /profiles/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "yeojoonsoo02@gmail.com";
    }

    // Comments: public read, authenticated create with validation, admin delete
    // (이전엔 delete: false 였으나 클라이언트 UI에서 관리자 삭제가 작동하지 않아 일치시킴)
    match /comments/{doc} {
      allow read: if true;
      // author는 토큰의 표시 이름과 일치해야 한다(타인 사칭 방지).
      // 표시 이름이 없는 계정은 빈 문자열만 허용 — 클라이언트가 이메일을 대신
      // 저장하던 경로를 막아 공개 컬렉션에 이메일이 남지 않게 한다.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['text', 'author', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 1000
        && request.resource.data.author is string
        && (request.resource.data.author == request.auth.token.name
            || request.resource.data.author == '');
      allow delete: if request.auth != null
        && request.auth.token.email == "yeojoonsoo02@gmail.com";
      allow update: if false;
    }

    // Visitor counter: 누구나 읽기 가능하나 쓰기는 "정확히 1씩 증가"만 허용.
    // 악성 봇의 무한 증가·초기화·임의 값 삽입 차단(비용 상승 방지).
    match /counters/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == 1
        && request.resource.data.count is int;
      allow update: if request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Portfolio: public read, admin write
    match /portfolio/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "yeojoonsoo02@gmail.com";
    }

    // Prompt logs: 인증된 사용자만 create + 엄격한 검증.
    // (이전에 인증 없이 허용되어 악성 로그 주입 가능했던 문제 해결)
    match /prompt_logs/{doc} {
      allow create: if request.auth != null
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() < 2000;
      allow read, update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
