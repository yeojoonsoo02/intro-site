rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 서버 전용 컬렉션 — Admin SDK만 쓴다(Rules를 우회함). 클라이언트는 전면 차단.
    match /chat_logs/{doc} {
      allow read, write: if false;
    }
    match /rate_limits/{doc} {
      allow read, write: if false;
    }

    // 프로필·포트폴리오: 공개 읽기. 쓰기는 관리자 UI를 없앴으므로 클라이언트에서는
    // 하지 않는다 — 편집은 Firebase 콘솔이나 서비스 계정 스크립트로만.
    match /profiles/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /portfolio/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // 방문자 카운터: 공개 읽기, 쓰기는 서버(/api/visits)만.
    // 서버가 봇 검사·rate limit·쿠키 중복 집계를 거쳐서만 증가시킨다.
    match /counters/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // 그 외 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
